{"info": {"description": "POC Observability Infrastructure — every endpoint from every service (generated from openapi.yaml). Import via Postman > Import > File. Base URLs are collection variables — edit them if you remapped ports.\n\nSeed data: accounts BANK-0001 (5000), BANK-0002 (1500), BANK-0003 (50000); policies b1c2e8d0-...000001 ACTIVE 100000, ...000002 ACTIVE 50000, ...000003 INACTIVE 75000.\n\nGrafana: http://localhost:3000 admin/admin. OTLP/HTTP needs Authorization: Bearer <BANKING_TOKEN|INSURANCE_TOKEN> (root .env).", "name": "POC Observability — All Services", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"}, "item": [{"description": "banking-api :8080", "item": [{"event": [{"listen": "test", "script": {"exec": ["var j = null; try { j = pm.response.json(); } catch (e) {}", "if (j && j.id) { pm.collectionVariables.set('transferId', j.id); }"], "type": "text/javascript"}}], "name": "Create transfer — happy path", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0001\",\n  \"destinationAccountNumber\": \"BANK-0002\",\n  \"amount\": 100.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers"], "raw": "{{bankingBaseUrl}}/transfers"}}}, {"name": "Create transfer — FRAUD REJECT (>=10000, needs funded acct)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0003\",\n  \"destinationAccountNumber\": \"BANK-0001\",\n  \"amount\": 15000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers"], "raw": "{{bankingBaseUrl}}/transfers"}}}, {"name": "Create transfer — INSUFFICIENT BALANCE (422)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0002\",\n  \"destinationAccountNumber\": \"BANK-0001\",\n  \"amount\": 5000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers"], "raw": "{{bankingBaseUrl}}/transfers"}}}, {"name": "Create transfer — ACCOUNT NOT FOUND (404)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"NOPE-9999\",\n  \"destinationAccountNumber\": \"BANK-0001\",\n  \"amount\": 10.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers"], "raw": "{{bankingBaseUrl}}/transfers"}}}, {"name": "Create transfer — VALIDATION ERROR (400)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0001\",\n  \"destinationAccountNumber\": \"BANK-0002\",\n  \"amount\": 0\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers"], "raw": "{{bankingBaseUrl}}/transfers"}}}, {"name": "Get transfer by id", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["transfers", "{{transferId}}"], "raw": "{{bankingBaseUrl}}/transfers/{{transferId}}"}}}, {"name": "Create account", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"accountNumber\": \"BANK-9001\",\n  \"balance\": 1000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["accounts"], "raw": "{{bankingBaseUrl}}/accounts"}}}, {"name": "Get account BANK-0001", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["accounts", "BANK-0001"], "raw": "{{bankingBaseUrl}}/accounts/BANK-0001"}}}], "name": "Banking API"}, {"description": "fraud-service :8081 — internal to client-banking network, normally called by banking-api", "item": [{"name": "Fraud check — approve", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0001\",\n  \"amount\": 100.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{fraudBaseUrl}}"], "path": ["fraud-check"], "raw": "{{fraudBaseUrl}}/fraud-check"}}}, {"name": "Fraud check — reject (suspicious_amount)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"sourceAccountNumber\": \"BANK-0003\",\n  \"amount\": 15000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{fraudBaseUrl}}"], "path": ["fraud-check"], "raw": "{{fraudBaseUrl}}/fraud-check"}}}], "name": "Fraud Service (internal)"}, {"description": "insurance-api :8083 (container serves 8080)", "item": [{"event": [{"listen": "test", "script": {"exec": ["var j = null; try { j = pm.response.json(); } catch (e) {}", "if (j && j.id) { pm.collectionVariables.set('claimId', j.id); }"], "type": "text/javascript"}}], "name": "Create claim — happy path (ACTIVE policy)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 1000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyActive1}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyActive1}}/claims"}}}, {"name": "Create claim — POLICY INACTIVE (422)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 1000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyInactive}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyInactive}}/claims"}}}, {"name": "Create claim — COVERAGE EXCEEDED (422, limit 50000)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 60000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyActive2}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyActive2}}/claims"}}}, {"name": "Create claim — RISK REJECT high_value (422, >50000)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 60000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyActive1}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyActive1}}/claims"}}}, {"name": "Create claim — RISK REJECT exhaustion (422, >80% limit)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 85000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyActive1}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyActive1}}/claims"}}}, {"name": "Create claim — POLICY NOT FOUND (404)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 100.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "00000000-0000-4000-8000-000000000000", "claims"], "raw": "{{insuranceBaseUrl}}/policies/00000000-0000-4000-8000-000000000000/claims"}}}, {"name": "Create claim — VALIDATION ERROR (400)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"amount\": 0\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["policies", "{{policyActive1}}", "claims"], "raw": "{{insuranceBaseUrl}}/policies/{{policyActive1}}/claims"}}}], "name": "Insurance API"}, {"description": "risk-service :8082 — internal to client-insurance network", "item": [{"name": "Risk check — approve", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"policyId\": \"b1c2e8d0-2222-4b3b-8d2b-000000000001\",\n  \"claimAmount\": 1000.00,\n  \"coverageLimit\": 100000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{riskBaseUrl}}"], "path": ["risk-check"], "raw": "{{riskBaseUrl}}/risk-check"}}}, {"name": "Risk check — reject high_value", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"policyId\": \"b1c2e8d0-2222-4b3b-8d2b-000000000001\",\n  \"claimAmount\": 60000.00,\n  \"coverageLimit\": 100000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{riskBaseUrl}}"], "path": ["risk-check"], "raw": "{{riskBaseUrl}}/risk-check"}}}, {"name": "Risk check — reject coverage_exhaustion", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"policyId\": \"b1c2e8d0-2222-4b3b-8d2b-000000000001\",\n  \"claimAmount\": 85000.00,\n  \"coverageLimit\": 100000.00\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{riskBaseUrl}}"], "path": ["risk-check"], "raw": "{{riskBaseUrl}}/risk-check"}}}], "name": "Risk Service (internal)"}, {"description": "Spring Boot actuator — exposure is health,info,metrics on every Java service. Duplicate the folder or swap the base URL variable to target banking / fraud / insurance / risk.", "item": [{"name": "Health — banking", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["actuator", "health"], "raw": "{{bankingBaseUrl}}/actuator/health"}}}, {"name": "Health — fraud", "request": {"header": [], "method": "GET", "url": {"host": ["{{fraudBaseUrl}}"], "path": ["actuator", "health"], "raw": "{{fraudBaseUrl}}/actuator/health"}}}, {"name": "Health — insurance", "request": {"header": [], "method": "GET", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["actuator", "health"], "raw": "{{insuranceBaseUrl}}/actuator/health"}}}, {"name": "Health — risk", "request": {"header": [], "method": "GET", "url": {"host": ["{{riskBaseUrl}}"], "path": ["actuator", "health"], "raw": "{{riskBaseUrl}}/actuator/health"}}}, {"name": "Info — banking", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["actuator", "info"], "raw": "{{bankingBaseUrl}}/actuator/info"}}}, {"name": "Metrics index — banking", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["actuator", "metrics"], "raw": "{{bankingBaseUrl}}/actuator/metrics"}}}, {"name": "Metric — bank.transfers.total", "request": {"header": [], "method": "GET", "url": {"host": ["{{bankingBaseUrl}}"], "path": ["actuator", "metrics", "bank.transfers.total"], "raw": "{{bankingBaseUrl}}/actuator/metrics/bank.transfers.total"}}}, {"name": "Metrics index — insurance", "request": {"header": [], "method": "GET", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["actuator", "metrics"], "raw": "{{insuranceBaseUrl}}/actuator/metrics"}}}, {"name": "Metric — insurance.claims.total", "request": {"header": [], "method": "GET", "url": {"host": ["{{insuranceBaseUrl}}"], "path": ["actuator", "metrics", "insurance.claims.total"], "raw": "{{insuranceBaseUrl}}/actuator/metrics/insurance.claims.total"}}}], "name": "Actuator"}, {"description": "Grafana :3000 — basic auth admin/admin. Loki/Tempo/Mimir are internal-only; query them through Grafana.", "item": [{"name": "Grafana health (no auth)", "request": {"header": [], "method": "GET", "url": {"host": ["{{grafanaBaseUrl}}"], "path": ["api", "health"], "raw": "{{grafanaBaseUrl}}/api/health"}}}, {"name": "Search dashboards", "request": {"auth": {"basic": [{"key": "password", "value": "{{grafanaAdminPassword}}"}, {"key": "username", "value": "{{grafanaAdminUser}}"}], "type": "basic"}, "header": [], "method": "GET", "url": {"host": ["{{grafanaBaseUrl}}"], "path": ["api", "search"], "query": [{"key": "query", "value": "banking"}], "raw": "{{grafanaBaseUrl}}/api/search?query=banking"}}}, {"name": "List datasources (Loki/Tempo/Mimir)", "request": {"auth": {"basic": [{"key": "password", "value": "{{grafanaAdminPassword}}"}, {"key": "username", "value": "{{grafanaAdminUser}}"}], "type": "basic"}, "header": [], "method": "GET", "url": {"host": ["{{grafanaBaseUrl}}"], "path": ["api", "datasources"], "raw": "{{grafanaBaseUrl}}/api/datasources"}}}, {"name": "Mimir instant query via Grafana proxy", "request": {"auth": {"basic": [{"key": "password", "value": "{{grafanaAdminPassword}}"}, {"key": "username", "value": "{{grafanaAdminUser}}"}], "type": "basic"}, "header": [], "method": "GET", "url": {"host": ["{{grafanaBaseUrl}}"], "path": ["api", "prometheus", "grafana", "api", "v1", "query"], "query": [{"key": "query", "value": "sum(rate(bank_transfers_total[5m]))"}], "raw": "{{grafanaBaseUrl}}/api/prometheus/grafana/api/v1/query?query=sum(rate(bank_transfers_total[5m]))"}}}, {"name": "Datasource query API (Loki example)", "request": {"auth": {"basic": [{"key": "password", "value": "{{grafanaAdminPassword}}"}, {"key": "username", "value": "{{grafanaAdminUser}}"}], "type": "basic"}, "body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"queries\": [\n    {\n      \"refId\": \"A\",\n      \"datasource\": { \"type\": \"loki\", \"uid\": \"loki\" },\n      \"expr\": \"{service_namespace=\\\"banking\\\"}\"\n    }\n  ]\n}"}, "header": [{"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{grafanaBaseUrl}}"], "path": ["api", "ds", "query"], "raw": "{{grafanaBaseUrl}}/api/ds/query"}}}], "name": "Grafana / Observability"}, {"description": "OTLP/HTTP ingestion through the gateway. Set bankingToken / insuranceToken from root .env (BANKING_TOKEN / INSURANCE_TOKEN). gRPC listeners :4317 (banking) / :4320 (insurance) cannot be sent from Postman HTTP — use grpcurl or the app itself.", "item": [{"name": "OTLP/HTTP banking — logs (empty payload = connectivity check)", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceLogs\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{bankingToken}}"}], "method": "POST", "url": {"host": ["{{otlpBankingHttp}}"], "path": ["v1", "logs"], "raw": "{{otlpBankingHttp}}/v1/logs"}}}, {"name": "OTLP/HTTP banking — metrics", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceMetrics\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{bankingToken}}"}], "method": "POST", "url": {"host": ["{{otlpBankingHttp}}"], "path": ["v1", "metrics"], "raw": "{{otlpBankingHttp}}/v1/metrics"}}}, {"name": "OTLP/HTTP banking — traces", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceSpans\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{bankingToken}}"}], "method": "POST", "url": {"host": ["{{otlpBankingHttp}}"], "path": ["v1", "traces"], "raw": "{{otlpBankingHttp}}/v1/traces"}}}, {"name": "OTLP/HTTP insurance — logs", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceLogs\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{insuranceToken}}"}], "method": "POST", "url": {"host": ["{{otlpInsuranceHttp}}"], "path": ["v1", "logs"], "raw": "{{otlpInsuranceHttp}}/v1/logs"}}}, {"name": "OTLP/HTTP insurance — metrics", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceMetrics\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{insuranceToken}}"}], "method": "POST", "url": {"host": ["{{otlpInsuranceHttp}}"], "path": ["v1", "metrics"], "raw": "{{otlpInsuranceHttp}}/v1/metrics"}}}, {"name": "OTLP/HTTP insurance — traces", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\"resourceSpans\": []}"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{insuranceToken}}"}], "method": "POST", "url": {"host": ["{{otlpInsuranceHttp}}"], "path": ["v1", "traces"], "raw": "{{otlpInsuranceHttp}}/v1/traces"}}}], "name": "OTLP HTTP Ingestion"}], "variable": [{"value": "http://localhost:8080", "key": "bankingBaseUrl"}, {"value": "http://localhost:8081", "key": "fraudBaseUrl"}, {"value": "http://localhost:8083", "key": "insuranceBaseUrl"}, {"value": "http://localhost:8082", "key": "riskBaseUrl"}, {"value": "http://localhost:3000", "key": "grafanaBaseUrl"}, {"value": "admin", "key": "grafanaAdminUser"}, {"value": "admin", "key": "grafanaAdminPassword"}, {"value": "http://localhost:4318", "key": "otlpBankingHttp"}, {"value": "http://localhost:4321", "key": "otlpInsuranceHttp"}, {"value": "dev-banking-token-local-only", "key": "bankingToken"}, {"value": "dev-insurance-token-local-only", "key": "insuranceToken"}, {"value": "b1c2e8d0-2222-4b3b-8d2b-000000000001", "key": "policyActive1"}, {"value": "b1c2e8d0-2222-4b3b-8d2b-000000000002", "key": "policyActive2"}, {"value": "b1c2e8d0-2222-4b3b-8d2b-000000000003", "key": "policyInactive"}, {"value": "", "key": "transferId"}, {"value": "", "key": "claimId"}]}
