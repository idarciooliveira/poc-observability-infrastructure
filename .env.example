# Template for local setup. Copy to .env and fill in real values:
#   cp .env.example .env
#
# Phase 6 (FR-06): per-tenant ingestion tokens for the OTEL gateway.
# The gateway maps each token to its tenant server-side and overwrites
# tenant.id, so a client can never impersonate the other tenant.
# Real values live in .env (gitignored) and are NEVER committed.
# The fallbacks in docker-compose.yml are dev-only placeholders.

# Banking client -> tenant.id=banking-client, X-Scope-OrgID=banking-client (gateway :4317/:4318)
BANKING_TOKEN=change-me-banking-token
# Insurance client -> tenant.id=insurance-client, X-Scope-OrgID=insurance-client (gateway :4320/:4321)
INSURANCE_TOKEN=change-me-insurance-token

# Prod hardening #4: Grafana admin is NOT hardcoded. Set strong values in .env.
# Create a read-only Viewer via Grafana UI (Server Admin > Users) for demos;
# never share admin in production.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=180014
