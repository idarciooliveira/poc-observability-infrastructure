{
  "uid": "poc-banking",
  "title": "POC — Banking",
  "tags": ["poc", "phase-8", "banking"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Transfer rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum by (status) (rate(bank_transfers_total{tenant_id=\"banking-client\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Fraud rejection rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum(rate(bank_fraud_rejected_total{tenant_id=\"banking-client\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fraud rejection ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum(rate(bank_fraud_rejected_total{tenant_id=\"banking-client\"}[$__rate_interval])) / sum(rate(bank_transfers_total{tenant_id=\"banking-client\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "Max transfer latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "description": "Max (not p95): the OTel-translated business timers carry only a +Inf bucket, so histogram_quantile is NaN. Max still shows latency spikes (e.g. chaos injection).",
      "targets": [
        {
          "expr": "max(bank_transfer_duration_max_seconds{tenant_id=\"banking-client\"})",
          "legendFormat": "max transfer",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Max fraud-check latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "description": "Max (not p95): see transfer latency note above.",
      "targets": [
        {
          "expr": "max(bank_fraud_duration_max_seconds{tenant_id=\"banking-client\"})",
          "legendFormat": "max fraud.check",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Banking logs (trace_id links to Tempo)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki_ds" },
      "targets": [
        {
          "expr": "{tenant_id=\"banking-client\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
