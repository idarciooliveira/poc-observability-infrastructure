{
  "uid": "poc-infrastructure",
  "title": "POC — Infrastructure",
  "tags": ["poc", "phase-8"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP errors (4xx/5xx) by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum by (service_name, http_response_status_code) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{http_response_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM memory used by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "sum by (service_name) (jvm_memory_used_bytes)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "Process CPU usage by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "avg by (service_name) (process_cpu_usage)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
    },
    {
      "id": 5,
      "title": "JVM live threads by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir_ds" },
      "targets": [
        {
          "expr": "avg by (service_name) (jvm_threads_live)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Warnings & errors by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki_ds" },
      "description": "Handled business failures (422s) log at warn, not error — error-only would sit empty until an unhandled 500 occurs. detected_level is metadata, not an index label, so streams are selected by service_name first.",
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"} | detected_level=~\"error|warn\" [$__interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
