# Template for local setup. Copy to .env and fill in values:
#   cp .env.example .env
POSTGRES_DB=retail_orders
POSTGRES_USER=retail_orders
POSTGRES_PASSWORD=change-me
RETAIL_API_PORT=8084
POSTGRES_PORT=5434
ENV=dev
# Ch.2: app exports to the LOCAL client collector only (plaintext, no token).
# The collector holds RETAIL_TOKEN and forwards via Traefik to the gateway.
OTEL_EXPORTER_OTLP_ENDPOINT=http://client-collector-retail-orders:4317
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true
# Gateway credential for the collector's platform leg (forwarding via
# Traefik SNI retail-otlp.localhost -> gateway :4322/:4323).
# Must match RETAIL_TOKEN in the root observability .env.
RETAIL_TOKEN=change-me-retail-token
# Phase 8-style fault injection. 0/0 = disabled. LATENCY_MS adds artificial
# processing delay (investigation demo); FAIL_RATE 0..1 forces random 500s.
CHAOS_LATENCY_MS=0
CHAOS_FAIL_RATE=0
