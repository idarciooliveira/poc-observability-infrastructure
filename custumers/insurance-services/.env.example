# Template for local setup. Copy to .env and fill in values:
#   cp .env.example .env
#
# Phase 6 (FR-06): bearer token for the gateway's insurance listener (:4320/:4321).
# Must match INSURANCE_TOKEN in the root observability .env; sent via
# OTEL_EXPORTER_OTLP_HEADERS as `Authorization: Bearer <token>`.
# NOTE: the start scripts (scripts/up.sh, scripts/up.ps1) export the root
# .env tokens into the environment, so the root .env stays the single
# source of truth and client values cannot drift.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4320
INSURANCE_TOKEN=change-me-insurance-token
# Phase 8 fault injection (risk-service). 0/0 = disabled. LATENCY_MS > 2000
# also trips insurance-api's 2s risk-evaluation timeout.
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0
