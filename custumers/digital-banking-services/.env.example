# Template for local setup. Copy to .env and fill in values:
#   cp .env.example .env
POSTGRES_DB=digital_banking
POSTGRES_USER=digital_banking
POSTGRES_PASSWORD=change-me
BANKING_API_PORT=8080
FRAUD_SERVICE_PORT=8081
POSTGRES_PORT=5432
ENV=dev
# OpenTelemetry: OTLP/gRPC via Traefik edge (TLS, SNI banking-otlp.localhost).
# Traefik terminates TLS and forwards h2c to the gateway; gateway still
# enforces BANKING_TOKEN -> tenant.id=banking-client.
OTEL_EXPORTER_OTLP_ENDPOINT=https://banking-otlp.localhost
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true
# Phase 6 (FR-06): bearer token for the gateway's banking listener (:4317).
# Must match BANKING_TOKEN in the root observability .env; sent via
# OTEL_EXPORTER_OTLP_HEADERS as `Authorization: Bearer <token>`.
BANKING_TOKEN=change-me-banking-token
# Phase 8 fault injection (fraud-service). 0/0 = disabled. LATENCY_MS > 2000
# also trips banking-api's 2s fraud-check timeout. Toggle with
# `CHAOS_LATENCY_MS=2500 docker compose up -d fraud-service` — no rebuild.
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0
