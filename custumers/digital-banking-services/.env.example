# Template for local setup. Copy to .env and fill in values:
#   cp .env.example .env
POSTGRES_DB=digital_banking
POSTGRES_USER=digital_banking
POSTGRES_PASSWORD=change-me
BANKING_API_PORT=8080
POSTGRES_PORT=5432
ENV=dev
# OpenTelemetry (Phase 2: logging = stdout, nothing leaves the service)
OTEL_SERVICE_NAME=banking-api
OTEL_TRACES_EXPORTER=logging
OTEL_METRICS_EXPORTER=logging
OTEL_LOGS_EXPORTER=logging
OTEL_METRIC_EXPORT_INTERVAL=15000
# Reserved for Phase 3 (collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
